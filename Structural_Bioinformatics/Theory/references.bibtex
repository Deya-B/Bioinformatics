@article{Yang2012,
    issn = {0027-8424},
    abstract = {Calcium influx through the Ca2+ release-activated Ca2+ (CRAC) channel is an essential process in many types of cells. Upon store depletion, the calcium sensor in the endoplasmic reticulum, STIM1, activates Orai1, a CRAC channel in the plasma membrane. We have determined the structures of SOAR from Homo sapiens (hSOAR), which is part of STIM1 and is capable of constitutively activating Orai1, and the entire coiled coil region of STIM1 from Caenorhabditis elegans (ceSTIM1-CCR) in an inactive state. Our studies reveal that the formation of a SOAR dimer is necessary to activate the Orai1 channel. Mutations that disrupt SOAR dimerization or remove the cluster of positive residues abolish STIM1 activation of Orai1. We identified a possible inhibitory helix within the structure of ceSTIM1-CCR that tightly interacts with SOAR. Functional studies suggest that the inhibitory helix may keep the C-terminus of STIM1 in an inactive state. Our data allowed us to propose a model for STIM1 activation.},
    journal = {Proceedings of the National Academy of Sciences - PNAS},
    pages = {5657--5662},
    volume = {109},
    publisher = {National Academy of Sciences},
    number = {15},
    year = {2012},
    title = {Structural and mechanistic insights into the activation of Stromal interaction molecule 1 (STIM1)},
    copyright = {copyright © 1993-2008 National Academy of Sciences of the United States of America},
    language = {eng},
    address = {United States},
    author = {Yang, Xue and Jin, Hao and Cai, Xiangyu and Li, Siwei and Shen, Yuequan},
    url = {https://www.pnas.org/doi/full/10.1073/pnas.1118947109},
    keywords = {Amino Acids ; Amino Acids - metabolism ; Animals ; Antibodies ; Biological Sciences ; Caenorhabditis elegans ; Caenorhabditis elegans - metabolism ; Caenorhabditis elegans Proteins ; Caenorhabditis elegans Proteins - chemistry ; Caenorhabditis elegans Proteins - metabolism ; Calcium ; Cells ; chemistry ; Cluster Analysis ; dimerization ; Dimers ; endoplasmic reticulum ; HEK293 Cells ; HeLa Cells ; Humans ; Membrane Proteins ; Membrane Proteins - chemistry ; Membrane Proteins - metabolism ; Membranes ; metabolism ; Models Biological ; Models Molecular ; Molecular interactions ; Molecules ; Monomers ; Mutation ; Nematodes ; Neoplasm Proteins ; Neoplasm Proteins - chemistry ; Neoplasm Proteins - metabolism ; plasma membrane ; Protein Conformation ; Protein Multimerization ; Protein Structure Tertiary ; Proteins ; Sensors ; Stromal Interaction Molecule 1 ; Structure-Activity Relationship},
}

@article{Hou2012,
issn = {0036-8075},
    abstract = {The plasma membrane protein Orai forms the pore of the calcium release—activated calcium (CRAC) channel and generates sustained cytosolic calcium signals when triggered by depletion of calcium from the endoplasmic reticulum. The crystal structure of Orai from Drosophila melanogaster, determined at 3.35 angstrom resolution, reveals that the calcium channel is composed of a hexameric assembly of Orai subunits arranged around a central ion pore. The pore traverses the membrane and extends into the cytosol. A ring of glutamate residues on its extracellular side forms the selectivity filter. A basic region near the intracellular side can bind anions that may stabilize the closed state. The architecture of the channel differs markedly from other ion channels and gives insight into the principles of selective calcium permeation and gating.},
    journal = {Science (American Association for the Advancement of Science)},
    pages = {1308--1313},
    volume = {338},
    publisher = {American Association for the Advancement of Science},
    number = {6112},
    year = {2012},
    title = {Crystal Structure of the Calcium Release—Activated Calcium Channel Orai},
    copyright = {Copyright © 2012 American Association for the Advancement of Science},
    language = {eng},
    address = {Washington, DC},
    author = {Hou, Xiaowei and Pedi, Leanne and Diver, Melinda M. and Long, Stephen B.},
    url = {https://pmc.ncbi.nlm.nih.gov/articles/PMC3695727/pdf/nihms-485691.pdf},
}

