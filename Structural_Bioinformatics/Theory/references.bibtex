@article{Hogan2015,
    issn = {0006-291X},
    abstract = {Store-operated calcium entry is a central mechanism in cellular calcium signalling and in maintaining cellular calcium balance. This review traces the history of research on store-operated calcium entry, the discovery of STIM and ORAI as central players in calcium entry, and the role of STIM and ORAI in biology and human disease. It describes current knowledge of the basic mechanism of STIM-ORAI signalling and of the varied mechanisms by which STIM-ORAI signalling can be modulated.},
    journal = {Biochemical and biophysical research communications},
    pages = {40--49},
    volume = {460},
    publisher = {Elsevier Inc},
    number = {1},
    year = {2015},
    title = {Store-operated calcium entry: Mechanisms and modulation},
    copyright = {2015 Elsevier Inc.},
    language = {eng},
    address = {United States},
    author = {Hogan, Patrick G. and Rao, Anjana},
    keywords = {Animals ; calcium ; Calcium - metabolism ; Calcium channel ; Calcium Channels - metabolism ; calcium signaling ; Calcium Signaling - physiology ; Cell Membrane - physiology ; CRAC current ; human diseases ; Humans ; Ion Channel Gating - physiology ; Membrane Proteins - metabolism ; Models Biological ; ORAI1 ; ORAI1 Protein ; STIM1 ; Store-operated calcium entry},
    url = {https://pmc.ncbi.nlm.nih.gov/articles/PMC4441756/},
}

